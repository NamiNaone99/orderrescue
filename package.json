{
  "name": "orderrescue",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:tz": "cross-env TZ=UTC vitest run tests/domain && cross-env TZ=Asia/Bangkok vitest run tests/domain",
    "e2e": "playwright test",
    "smoke": "playwright test --grep @smoke",
    "eval:rows": "tsx scripts/eval-rows.ts",
    "eval:check-corpus": "cross-env EVAL_REQUIRE_FULL_CORPUS=1 vitest run tests/evals/file.test.ts",
    "eval": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/eval.ts",
    "try:interpret": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/try-interpret.ts",
    "test:db": "node --env-file=.env.local node_modules/vitest/vitest.mjs run tests/store/supabase.test.ts",
    "data:build": "tsx scripts/build-dataset.ts",
    "data:seed-sql": "tsx scripts/seed-sql.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/supabase-js": "^2.119.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "openai": "^7.62.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fast-check/vitest": "^0.5.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "cross-env": "^10.1.0",
    "csv-parse": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fast-check": "^4.10.3",
    "jsdom": "^31.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@9.15.9"
}
